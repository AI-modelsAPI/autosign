<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JustSign" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:dialogTheme">@style/Theme.JustSign.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.JustSign.Dialog</item>
    </style>
    <style name="Theme.JustSign.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:colorAccent">#2563EB</item>
    </style>
    <style name="Theme.JustSign.Auth" parent="Theme.JustSign">
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
